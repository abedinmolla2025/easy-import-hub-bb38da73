{
 "trailingSlash": false,
 "redirects": [
  {
   "source": "/(.*)",
   "has": [
    {
     "type": "host",
     "value": "www.noorapp.in"
    }
   ],
   "destination": "https://noorapp.in/$1",
   "statusCode": 301
  },
  {
   "source": "/bukhari",
   "destination": "/hadith/sahih-bukhari",
   "statusCode": 301
  },
  {
   "source": "/hadith/bukhari",
   "destination": "/hadith/sahih-bukhari",
   "statusCode": 301
  },
  {
   "source": "/sahih-al-bukhari",
   "destination": "/hadith/sahih-bukhari",
   "statusCode": 301
  },
  {
   "source": "/sahih-al-bukhari/:lang",
   "destination": "/hadith/sahih-bukhari/:lang",
   "statusCode": 301
  },
  {
   "source": "/app/noorapp.apk",
   "destination": "/download",
   "statusCode": 301
  },
  {
   "source": "/names",
   "destination": "/baby-names",
   "statusCode": 301
  }
 ],
 "headers": [
  {
   "source": "/sitemap.xml",
   "headers": [
    {
     "key": "Content-Type",
     "value": "application/xml; charset=utf-8"
    },
    {
     "key": "Cache-Control",
     "value": "public, max-age=3600, s-maxage=86400"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {"key": "X-Content-Type-Options", "value": "nosniff"},
    {"key": "X-Frame-Options", "value": "SAMEORIGIN"},
    {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
    {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)"}
   ]
  }
 ],
 "rewrites": [
  {
   "source": "/sitemap-dynamic.xml",
   "destination": "/api/sitemap-dynamic"
  },
  {
   "source": "/data-sources",
   "has": [
    {
     "type": "header",
     "key": "user-agent",
     "value": ".*(Googlebot|facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|Discordbot|LinkedInBot|Pinterest|slackbot|Applebot).*"
    }
   ],
   "destination": "/api/prerender?path=/data-sources"
  },
  {
   "source": "/((?!assets|favicon|og-|pwa-|manifest|robots|sitemap\\.xml|sw\\.js|data|api/).*)",
   "has": [
    {
     "type": "header",
     "key": "user-agent",
     "value": ".*(Googlebot|facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|Discordbot|LinkedInBot|Pinterest|slackbot|Applebot).*"
    }
   ],
   "destination": "/api/prerender?path=/$1"
  },
  {
   "source": "/",
   "has": [
    {
     "type": "header",
     "key": "user-agent",
     "value": ".*(Googlebot|facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|Discordbot|LinkedInBot|Pinterest|slackbot|Applebot).*"
    }
   ],
   "destination": "/api/prerender?path=/"
  },
  {
   "source": "/(.*)",
   "destination": "/"
  }
 ],
 "crons": [
  {
   "path": "/api/scheduler-tick",
   "schedule": "0 0 * * *"
  }
 ]
}